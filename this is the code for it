import os
import sys
import json
import shutil
import threading
import time
from datetime import datetime
import tkinter as tk
from tkinter import filedialog, messagebox, ttk

CONFIG_FILE = "saveguard_config.json"

class SaveGuardApp:
    def __init__(self, root):
        self.root = root
        self.root.title("SaveGuard Pro - Offline Game Backup")
        self.root.geometry("600x520")
        self.root.configure(bg="#1e1e2e")
        
        # Style Configuration for Modern Dark Mode
        self.style = ttk.Style()
        self.style.theme_use("clam")
        self.style.configure(".", background="#1e1e2e", foreground="#cdd6f4")
        self.style.configure("TLabel", background="#1e1e2e", foreground="#cdd6f4", font=("Segoe UI", 10))
        self.style.configure("TEntry", fieldbackground="#313244", foreground="#cdd6f4", borderwidth=0)
        
        # State variables
        self.src_dir = tk.StringVar()
        self.dst_dir = tk.StringVar()
        self.interval_mins = tk.IntVar(value=15)
        self.is_monitoring = False
        
        self.setup_ui()
        self.load_config()

    def setup_ui(self):
        # Header Banner
        header = tk.Label(self.root, text="🛡️ SaveGuard Pro", bg="#1e1e2e", fg="#89b4fa", font=("Segoe UI", 18, "bold"))
        header.pack(pady=15)

        # Main Container Frame
        main_frame = tk.Frame(self.root, bg="#1e1e2e")
        main_frame.pack(fill="both", expand=True, padx=25)

        # --- FOLDER CHOOSERS ---
        # Source Directory
        ttk.Label(main_frame, text="Game Save Folder (Source):").pack(anchor="w", pady=(5, 2))
        src_f = tk.Frame(main_frame, bg="#1e1e2e")
        src_f.pack(fill="x", pady=2)
        self.src_entry = ttk.Entry(src_f, textvariable=self.src_dir, font=("Segoe UI", 9))
        self.src_entry.pack(side="left", fill="x", expand=True, ipady=4)
        tk.Button(src_f, text="Browse", bg="#45475a", fg="#cdd6f4", bd=0, padx=10, command=self.browse_src).pack(side="right", padx=(5, 0))

        # Destination Directory
        ttk.Label(main_frame, text="Secure Backup Destination:").pack(anchor="w", pady=(15, 2))
        dst_f = tk.Frame(main_frame, bg="#1e1e2e")
        dst_f.pack(fill="x", pady=2)
        self.dst_entry = ttk.Entry(dst_f, textvariable=self.dst_dir, font=("Segoe UI", 9))
        self.dst_entry.pack(side="left", fill="x", expand=True, ipady=4)
        tk.Button(dst_f, text="Browse", bg="#45475a", fg="#cdd6f4", bd=0, padx=10, command=self.browse_dst).pack(side="right", padx=(5, 0))

        # --- AUTOMATION & TIMER CONTROLS ---
        auto_f = tk.LabelFrame(main_frame, text=" Live Automation Engine ", bg="#1e1e2e", fg="#a6e3a1", font=("Segoe UI", 10, "bold"), bd=1, labelanchor="n")
        auto_f.pack(fill="x", pady=20, ipady=8)
        
        timer_sub = tk.Frame(auto_f, bg="#1e1e2e")
        timer_sub.pack(pady=5)
        ttk.Label(timer_sub, text="Backup Interval (Minutes):").pack(side="left", padx=5)
        ttk.Entry(timer_sub, textvariable=self.interval_mins, width=6, font=("Segoe UI", 10, "bold"), justify="center").pack(side="left", padx=5)

        self.btn_toggle = tk.Button(auto_f, text="▶ Start Auto-Backup Loop", bg="#a6e3a1", fg="#11111b", font=("Segoe UI", 10, "bold"), bd=0, pady=6, padx=15, command=self.toggle_monitoring)
        self.btn_toggle.pack(pady=(10, 0))

        # --- MANUAL ACTION BUTTONS ---
        btn_f = tk.Frame(main_frame, bg="#1e1e2e")
        btn_f.pack(fill="x", pady=5)
        tk.Button(btn_f, text="🚀 Manual Backup", bg="#89b4fa", fg="#11111b", font=("Segoe UI", 10, "bold"), bd=0, pady=8, command=self.manual_backup).pack(side="left", fill="x", expand=True, padx=(0, 5))
        tk.Button(btn_f, text="⏪ Restore Latest Save", bg="#f38ba8", fg="#11111b", font=("Segoe UI", 10, "bold"), bd=0, pady=8, command=self.restore_backup).pack(side="right", fill="x", expand=True, padx=(5, 0))

        # --- LIVE SYSTEM LOGS ---
        ttk.Label(main_frame, text="Activity Logs:").pack(anchor="w", pady=(15, 2))
        self.log_box = tk.Text(main_frame, height=6, bg="#11111b", fg="#a6adc8", font=("Consolas", 9), bd=0, state="disabled")
        self.log_box.pack(fill="both", expand=True, pady=(0, 10))

    def log(self, message):
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.log_box.config(state="normal")
        self.log_box.insert("end", f"[{timestamp}] {message}\n")
        self.log_box.see("end")
        self.log_box.config(state="disabled")

    def browse_src(self):
        path = filedialog.askdirectory(title="Target Game Save Directory")
        if path: self.src_dir.set(path); self.save_config()

    def browse_dst(self):
        path = filedialog.askdirectory(title="Secure Backup Directory")
        if path: self.dst_dir.set(path); self.save_config()

    def load_config(self):
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r") as f:
                    config = json.load(f)
                    self.src_dir.set(config.get("src", ""))
                    self.dst_dir.set(config.get("dst", ""))
                    self.interval_mins.set(config.get("interval", 15))
                self.log("Saved folders loaded automatically.")
            except Exception:
                self.log("Failed to load past configurations.")

    def save_config(self):
        config = {"src": self.src_dir.get(), "dst": self.dst_dir.get(), "interval": self.interval_mins.get()}
        with open(CONFIG_FILE, "w") as f:
            json.dump(config, f)

    def execute_backup_core(self):
        src, dst = self.src_dir.get(), self.dst_dir.get()
        if not src or not dst: return False, "Paths not configured."
        if not os.path.exists(src): return False, "Source folder missing."
        try:
            ts = datetime.now().strftime("%Y-%m-%d_%H%M%S")
            final_dst = os.path.join(dst, f"Backup_{ts}")
            shutil.copytree(src, final_dst)
            return True, f"Created Snapshot: Backup_{ts}"
        except Exception as e:
            return False, str(e)

    def manual_backup(self):
        success, msg = self.execute_backup_core()
        if success:
            self.log(msg)
            messagebox.showinfo("Success", "Backup snapshot deployed securely.")
        else:
            messagebox.showerror("Error", f"Execution dropped: {msg}")

    def toggle_monitoring(self):
        if self.is_monitoring:
            self.is_monitoring = False
            self.btn_toggle.config(text="▶ Start Auto-Backup Loop", bg="#a6e3a1")
            self.log("Automated background looping stopped.")
        else:
            if not self.src_dir.get() or not self.dst_dir.get():
                messagebox.showerror("Error", "Configure your system directories before initializing the loop.")
                return
            self.is_monitoring = True
            self.btn_toggle.config(text="⏹ Stop Auto-Backup Loop", bg="#f38ba8")
            self.log(f"Background monitoring online. Interval: {self.interval_mins.get()} min.")
            self.save_config()
            threading.Thread(target=self.monitoring_loop, daemon=True).start()

    def monitoring_loop(self):
        while self.is_monitoring:
            success, msg = self.execute_backup_core()
            if success: self.log(f"Auto-Sync: {msg}")
            else: self.log(f"Auto-Sync Failed: {msg}")
            
            for _ in range(self.interval_mins.get() * 60):
                if not self.is_monitoring: break
                time.sleep(1)

    def restore_backup(self):
        src, dst = self.src_dir.get(), self.dst_dir.get()
        if not src or not dst: return
        
        try:
            backups = [os.path.join(dst, d) for d in os.listdir(dst) if os.path.isdir(os.path.join(dst, d)) and d.startswith("Backup_")]
            if not backups:
                messagebox.showerror("Error", "No historical packages found in destination.")
                return
            
            latest = max(backups, key=os.path.getmtime)
            confirm = messagebox.askyesno("Confirm Restore", f"Overwrite live save data with package data from:\n{os.path.basename(latest)}?")
            if not confirm: return
            
            if os.path.exists(src): shutil.rmtree(src)
            shutil.copytree(latest, src)
            self.log(f"Restored recovery data: {os.path.basename(latest)}")
            messagebox.showinfo("Restored", "Historical data loaded and rewritten successfully!")
        except Exception as e:
            messagebox.showerror("Error", f"Recovery engine fault: {str(e)}")

if __name__ == "__main__":
    root = tk.Tk()
    app = SaveGuardApp(root)
    root.mainloop()
